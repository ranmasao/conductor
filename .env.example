# Template for a project-local $PWD/.env. Conductor runs from the root of an already configured project checkout.
REMOTE_NAME=origin
# REMOTE_BRANCH=main

# Current directory-based ticket states.
TODO_PATH=kanban/todo
REVIEW_PATH=kanban/review
POLL_INTERVAL=300

# Fresh OpenCode process per run.
AGENT_PROMPT_FILE=/path/to/agent-prompt.txt
# Optional recovery prompt; defaults to Conductor's recovery-prompt.txt.
# RECOVERY_PROMPT_FILE=/path/to/recovery-prompt.txt
OPENCODE_BIN=opencode
OPENCODE_MODEL=provider/model
# OPENCODE_AGENT=build

# Persistent state and locks. The default is /var/lib/conductor.
# If /var/lib/conductor is not writable, Conductor offers a home-directory
# fallback interactively and can persist the choice here.
# STATE_DIR=~/.local/state/conductor
