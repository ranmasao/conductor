# Template for a project-local $PWD/.env. Conductor runs from the root of an already configured project checkout.
REMOTE_NAME=origin
# REMOTE_BRANCH=main

# Current directory-based ticket states.
TODO_PATH=kanban/todo
REVIEW_PATH=kanban/review
POLL_INTERVAL=300

# Fresh OpenCode process per run.
# Optional custom prompts; built-in prompts are used by default.
# AGENT_PROMPT_FILE=/path/to/custom-agent-prompt.txt
# RECOVERY_PROMPT_FILE=/path/to/custom-recovery-prompt.txt
OPENCODE_BIN=opencode
OPENCODE_MODEL=provider/model
# OPENCODE_AGENT=build

# Persistent state and locks. The default is $XDG_STATE_HOME/conductor,
# or ~/.local/state/conductor when XDG_STATE_HOME is not set.
# STATE_DIR=~/.local/state/conductor
